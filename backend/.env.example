# Salin file ini menjadi .env lalu sesuaikan isinya. JANGAN commit file .env.

# Kunci rahasia untuk tanda tangan token login. Wajib diisi di produksi.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=ganti-dengan-kunci-rahasia-acak

# True hanya saat pengembangan. Di server sekolah: False.
DEBUG=True

# Nama domain/IP server, dipisah koma. Contoh produksi: lms.smknj.sch.id,192.168.1.10
ALLOWED_HOSTS=localhost,127.0.0.1

# Alamat frontend yang boleh memanggil API. Contoh produksi: https://lms.smknj.sch.id
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Diperlukan untuk login halaman /admin/ Django di produksi. Contoh: https://lms.smknj.sch.id
CSRF_TRUSTED_ORIGINS=

# Batas ukuran upload (MB). Samakan dengan MAX_UPLOAD_MB di frontend/src/utils/constants.js.
MAX_UPLOAD_SIZE_MB=10

# Database. Bawaan: sqlite (file db.sqlite3). Untuk produksi bisa postgresql atau mysql.
DB_ENGINE=sqlite
# DB_NAME=lms_smknj
# DB_USER=lms
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=

# Isi True hanya jika server sudah memakai HTTPS (sertifikat SSL).
HTTPS=False
# SECURE_HSTS_SECONDS=31536000

# Tingkat log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=WARNING
