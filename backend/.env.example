# Salin file ini menjadi .env lalu sesuaikan isinya. JANGAN commit file .env.

# Kunci rahasia untuk tanda tangan token login. Wajib diisi di produksi.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=ganti-dengan-kunci-rahasia-acak

# True hanya saat pengembangan. Di server sekolah: False.
DEBUG=True

# Nama domain/IP server, dipisah koma. Contoh produksi: sigmateknologi.my.id,.sigmateknologi.my.id
# Subdomain per sekolah: awali dengan titik agar semua subdomain diterima, mis. .sigmateknologi.my.id
ALLOWED_HOSTS=localhost,127.0.0.1

# Alamat frontend yang boleh memanggil API. Contoh produksi: https://admin.sigmateknologi.my.id (tidak perlu jika API di alamat yang sama)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Pola alamat frontend (regex, dipisah koma) untuk subdomain per sekolah jika API di alamat lain.
# Mencoba subdomain di laptop: ^http://[a-z0-9-]+\.localhost:5173$
# Produksi dengan API di alamat yang sama (/api) tidak perlu diisi.
CORS_ALLOWED_ORIGIN_REGEXES=
# Diperlukan untuk login halaman /admin/ Django di produksi. Contoh: https://admin.sigmateknologi.my.id
CSRF_TRUSTED_ORIGINS=

# Batas ukuran upload (MB). Samakan dengan MAX_UPLOAD_MB di frontend/src/utils/constants.js.
MAX_UPLOAD_SIZE_MB=10
# Batas ukuran video soal video interaktif (MB). Samakan client_max_body_size di nginx (docs/DEPLOY.md).
MAX_VIDEO_UPLOAD_MB=100

# Database. Bawaan: sqlite (file db.sqlite3). Untuk produksi bisa postgresql atau mysql.
DB_ENGINE=sqlite
# DB_NAME=lms_smknj
# DB_USER=lms
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=

# Isi True hanya jika server sudah memakai HTTPS (sertifikat SSL).
HTTPS=False
# SECURE_HSTS_SECONDS=31536000

# Tingkat log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=WARNING

# Pembuat soal otomatis dengan AI (Claude API). Kosongkan untuk menonaktifkan fitur.
# Buat kunci di https://platform.claude.com (biaya dihitung per pemakaian).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
