VITE_API_URL=http://localhost:8000/api

# Subdomain per sekolah (opsional). Isi domain dasar, mis. sigmateknologi.my.id, agar
# smknj.sigmateknologi.my.id langsung membuka sekolah "smknj" dan admin.sigmateknologi.my.id
# menjadi alamat Super Admin. Kosong = satu alamat, sekolah dipilih lewat "Ganti Sekolah".
# Mencoba di laptop: VITE_BASE_DOMAIN=localhost lalu buka http://smknj.localhost:5173
VITE_BASE_DOMAIN=
