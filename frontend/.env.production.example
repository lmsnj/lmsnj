# Salin menjadi .env.production sebelum `npm run build` untuk server.
# API berada di alamat yang sama dengan frontend (Nginx meneruskan /api ke backend).
VITE_API_URL=/api
# Domain dasar: <kode>.sigmateknologi.my.id = sekolah, admin.sigmateknologi.my.id = Super Admin.
VITE_BASE_DOMAIN=sigmateknologi.my.id
